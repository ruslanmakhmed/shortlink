# Скопируйте в compose/.env (это делает scripts/bootstrap.sh).
# Пустое значение = дефолт из docker-compose.yml (указан в скобках).
# Пароль базы здесь НЕ хранится: он в compose/secrets/db_password.txt (генерирует bootstrap.sh).

# Версия образа приложения, совпадает с git-тегом (dev)
APP_VERSION=
# Порт на хосте (8080)
HOST_PORT=
# DEBUG | INFO | WARNING | ERROR (INFO)
LOG_LEVEL=
# Имя базы (shortlink)
DB_NAME=
# Пользователь базы (shortlink)
DB_USER=
# Реестр образов (localhost:5000)
REGISTRY=
